! ===== {{ hostname }} - generated by AI Network Automation (plan {{ plan_hash[:12] }}) =====
! Management interface {{ mgmt_interface or "(unknown)" }} is intentionally NOT touched.
hostname {{ hostname }}
!
{% for i in interfaces -%}
interface {{ i.name }}
 description {{ i.description }}
 ip address {{ i.ip }} {{ i.mask }}
{% if i.p2p %} ip ospf network point-to-point
{% endif %} no shutdown
!
{% endfor -%}
{% if loopback -%}
interface Loopback0
 description OSPF router-id (not advertised)
 ip address {{ router_id }} 255.255.255.255
!
{% endif -%}
router ospf {{ process_id }}
 router-id {{ router_id }}
{% for p in passive %} passive-interface {{ p }}
{% endfor %}{% for n in networks %} network {{ n.network }} {{ n.wildcard }} area {{ area }}
{% endfor %}!
end
