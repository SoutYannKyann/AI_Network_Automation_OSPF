# Copy to .env and fill in. .env is git-ignored - NEVER commit real values.

# --- AI (only the API container needs this) ---
# anthropic = Claude API (ANTHROPIC_API_KEY) | gemini = Google Gemini API (GEMINI_API_KEY)
# | ollama = local vision model, no key
AI_PROVIDER=anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=180
# Backup Gemini models tried in order when the primary is busy (503/429) or missing - free-tier models only
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
# Extra attempts per model on 503/429/timeouts (with short waits) before moving to the next model
GEMINI_RETRIES=2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
EXTRACTION_EFFORT=high
# Ollama on the Windows host; docker-compose points the API container at host.docker.internal
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT=600
# GPU layers: empty = Ollama decides; 0 = CPU only (use if Ollama's CUDA backend crashes)
OLLAMA_NUM_GPU=

# --- shared secrets between API and worker (generate: python -c "import secrets;print(secrets.token_hex(32))") ---
WORKER_TOKEN=change-me-worker-token
APPROVAL_HMAC_SECRET=change-me-hmac-secret

# --- authorised approvers (comma separated). Only these names can Approve or Undeploy;
# empty = any name is accepted. Restart the API after a change: docker compose up -d api
APPROVERS=

# --- router SSH credentials (only the worker uses these; names referenced from inventory.yaml) ---
SSH_USERNAME=
SSH_PASSWORD=
SSH_ENABLE_SECRET=

# --- worker behaviour ---
# true = built-in IOS simulator instead of real routers (rehearsal only)
SIMULATE_DEVICES=false
# reject | warn | autoadd
SSH_HOST_KEY_POLICY=warn
# optional known_hosts file path
SSH_KNOWN_HOSTS=
# true for old GNS3 IOS images (e.g. c7200 15.x) offering only ssh-rsa / SHA1
SSH_LEGACY_ALGORITHMS=false
SSH_TIMEOUT=15
SSH_COMMAND_TIMEOUT=30
ROLLBACK_ON_FAILURE=true
# true = 'write memory' after a successful deploy
SAVE_CONFIG=false
VERIFY_TIMEOUT=120
VERIFY_INTERVAL=10
JOB_LEASE_SECONDS=600

# --- Kafka (compose overrides KAFKA_BOOTSTRAP for containers) ---
KAFKA_BOOTSTRAP=localhost:29092
KAFKA_JOBS_TOPIC=network-config-jobs
KAFKA_RESULTS_TOPIC=network-config-results
